# Supabase Configuration
SUPABASE_PROJECT_ID="your-project-id"
SUPABASE_PUBLISHABLE_KEY="your-anon-publishable-key"
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key" # Required for server admin actions

VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-publishable-key"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# Public Site URL (Used for redirects and email links)
PUBLIC_SITE_URL="http://localhost:5173"

# Live Card Processing (Paystack)
# Obtain this from your Paystack Dashboard (https://dashboard.paystack.com/#/settings/developer)
# Webhook endpoint to configure in Paystack: /api/public/paystack/webhook
# Checkout redirect endpoint: /api/public/paystack/callback
PAYSTACK_SECRET_KEY="sk_test_..." # or sk_live_...

# M-Pesa (Safaricom Daraja API)
DARAJA_ENV="sandbox" # or "production"
DARAJA_CONSUMER_KEY=""
DARAJA_CONSUMER_SECRET=""
DARAJA_SHORTCODE="174379"
DARAJA_PASSKEY=""

# Transactional Emails (Resend)
# Obtain from https://resend.com/api-keys
# When not provided, transactional emails run in simulated mode and log to console
RESEND_API_KEY=""
EMAIL_FROM="Willow Student Wellbeing <notifications@yourdomain.com>"
SUPPORT_EMAIL="support.campuswell@gmail.com"